---
/**
 * Page shell: head, header, the positioned content canvas and footer.
 * - default slot: elements placed on the 980px canvas
 * - "bands" slot: full-width strips behind the canvas
 */
import '../styles/site.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { wix } from '../lib/layout';

interface Props {
  title: string;
  description?: string;
  /** Height of the content area in px (desktop layout). */
  height: number;
  /** Background colour of the content area. */
  bg?: string;
  /** Current page path for menu highlighting, e.g. "about/". */
  current?: string;
}

const {
  title,
  description = 'We Stand 4 Something — Enhancing Independence for People with Disabilities. Education, Advocacy, Empowerment.',
  height,
  bg = '#fff',
  current = '',
} = Astro.props;

const fonts =
  'https://fonts.googleapis.com/css2?family=Amatic+SC&family=Archivo+Black' +
  '&family=Barlow:ital,wght@0,300;0,700;1,300;1,700&family=Bree+Serif&family=Cinzel:wght@700' +
  '&family=Enriqueta:wght@400;700&family=Jost:wght@400;700&family=Libre+Baskerville:wght@400;700' +
  '&family=Lobster&family=Montserrat:wght@800&family=Nunito+Sans:wght@300;700' +
  '&family=Open+Sans:ital,wght@0,400;0,600;0,700;1,400&family=Playfair+Display:ital,wght@0,400;1,700' +
  '&family=Poppins:wght@600&display=swap';
const ogImage = wix('996292_29f929dcf65f4b76b7d5e6343b237bca~mv2.png');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <link rel="icon" href={wix('996292_c27297a55ebd4707ba1e7e31cc39572e~mv2.png/v1/fill/w_64,h_64,al_c,q_85/favicon.png')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fonts} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header current={current} />
    <main id="main" class="band page" style={`height:${height}px;background:${bg}`}>
      <slot name="bands" />
      <div class="canvas">
        <slot />
      </div>
    </main>
    <Footer />
    <slot name="after" />
  </body>
</html>
