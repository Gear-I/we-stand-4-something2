---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { pageTitle, wix } from '../lib/site';
import { LOGO } from '../data/site';

interface Props {
  /** Short page name, e.g. "About us". Omit on the home page. */
  title?: string;
  description?: string;
  /** Current page path for menu highlighting, e.g. "about/". */
  current?: string;
}

const {
  title,
  description = 'We Stand 4 Something is a Delaware nonprofit enhancing independence for people with disabilities through education, advocacy and empowerment.',
  current = '',
} = Astro.props;

const fonts = 'https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400;1,700&display=swap';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle(title)}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle(title)} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={wix('996292_29f929dcf65f4b76b7d5e6343b237bca~mv2.png')} />
    <meta name="theme-color" content="#093F3E" />
    <link rel="icon" href={wix(`${LOGO}/v1/fill/w_64,h_64,al_c,q_85/favicon.png`)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fonts} />
    <!-- Apply saved display settings before the page paints, so there is no flash. -->
    <script is:inline>
      try {
        const s = JSON.parse(localStorage.getItem('ws4s-display') || '{}');
        if (s.text) document.documentElement.dataset.text = s.text;
        if (s.contrast) document.documentElement.dataset.contrast = s.contrast;
      } catch (e) { /* storage unavailable: use defaults */ }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header current={current} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
