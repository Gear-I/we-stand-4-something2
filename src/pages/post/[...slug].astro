---
// Blog posts at their original Wix URLs, e.g. /post/2016/06/23/emmanuel-is-live-on-wboc-tv/
import Base from '../../layouts/Base.astro';
import PostMeta from '../../components/PostMeta.astro';
import { POSTS, type Post } from '../../data/site';
import { url, wix } from '../../lib/site';

export function getStaticPaths() {
  return POSTS.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
---
<Base title={post.title} description={post.excerpt ?? post.title}>
  <article class="section">
    <div class="container prose">
      <p><a href={url('blog-1/')}>Back to the blog</a></p>
      <h1>{post.title}</h1>
      <PostMeta post={post} />

      {post.youtube && (
        <>
          <div class="video">
            <iframe
              src={`https://www.youtube-nocookie.com/embed/${post.youtube}`}
              title={`Video: ${post.title}`}
              loading="lazy"
              allow="encrypted-media; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
          <p style="margin-top:1rem">
            <a href={`https://www.youtube.com/watch?v=${post.youtube}`}>Watch this video on YouTube</a>,
            where you can turn on captions if they are available.
          </p>
        </>
      )}

      {post.image && (
        <img src={wix(`${post.image}/v1/fill/w_790,h_848,al_c,lg_1,q_80/post.jpg`)} alt={post.imageAlt ?? ''} width="395" height="424" style="border-radius:0.75rem;margin-bottom:1.5rem" />
      )}

      {post.body && <p>{post.body}</p>}
    </div>
  </article>
</Base>
