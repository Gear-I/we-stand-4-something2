---
// Individual blog posts at their original Wix URLs, e.g. /post/2016/06/23/emmanuel-is-live-on-wboc-tv/
import Base from '../../layouts/Base.astro';
import Abs from '../../components/Abs.astro';
import Text from '../../components/Text.astro';
import PostMeta from '../../components/PostMeta.astro';
import { POSTS, type Post } from '../../data/site';
import { pos, url, wix, HEADER_H, FONTS } from '../../lib/layout';

export function getStaticPaths() {
  return POSTS.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const total = post.youtube ? 1300 : 1450;
---
<Base title={`${post.title} | ws4s`} description={post.body?.slice(0, 150)} height={total - HEADER_H} bg="#000">
  <div slot="bands" class="full deco blog-panel" style="top:0;bottom:0"></div>

  <Abs x={222} y={400} w={820}><PostMeta post={post} /></Abs>
  <Text x={222} y={460} w={820} as="h1" font="os" size={32} class="m-big">{post.title}</Text>

  {post.youtube ? (
    <Abs x={222} y={560} w={820} h={461} class="m-full video">
      <iframe src={`https://www.youtube-nocookie.com/embed/${post.youtube}`} title={post.title} loading="lazy" allowfullscreen></iframe>
    </Abs>
  ) : (
    <img class="a" src={wix(`${post.image}/v1/fill/w_790,h_848,al_c,lg_1,q_80/post.jpg`)} alt="Emmanuel Jenkins" width="395" height="424" style={pos(434, 560, 395, 424) + 'object-fit:cover'} />
  )}

  {post.body && <Text x={222} y={1010} w={820} size={18} lh="1.6" class="m-text">{post.body}</Text>}

  <Abs x={222} y={total - 120} href={url('blog-1/')} style={`font:400 14px ${FONTS.enr};color:#00995B;text-decoration:underline`}>&larr; All Posts</Abs>
</Base>
