---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import ContactForm, { type Field } from '../components/ContactForm.astro';

const fields: Field[] = [
  { name: 'first', label: 'First name', type: 'text', required: true, autocomplete: 'given-name', pairWithNext: true },
  { name: 'last', label: 'Last name', type: 'text', autocomplete: 'family-name' },
  { name: 'email', label: 'Email address', type: 'email', required: true, autocomplete: 'email', pairWithNext: true },
  { name: 'phone', label: 'Phone number', type: 'tel', autocomplete: 'tel' },
  { name: 'message', label: 'Your feedback', type: 'textarea', required: true, hint: 'Tell us what works, what doesn’t, or a resource we should add.' },
];
---
<Base title="Give us feedback" current="feedback/" description="Tell We Stand 4 Something how we are doing and how we can improve, including how to make this website easier to use.">
  <PageIntro title="Your feedback matters">
    <p>
      We appreciate any feedback you can give us, including ways to make our website more accessible and easier to navigate.
      We strive to offer the best services and resources, so let us know how we are doing and how we can improve.
    </p>
  </PageIntro>

  <section class="section" aria-labelledby="form-title">
    <div class="container">
      <div class="panel" style="max-width:44rem">
        <h2 id="form-title">Contact us</h2>
        <ContactForm id="feedback" subject="Website feedback" fields={fields} submitLabel="Send feedback" />
      </div>
    </div>
  </section>
</Base>
