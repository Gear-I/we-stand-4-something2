---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import { DONATE } from '../data/site';
import { url } from '../lib/site';
---
<Base title="Friday Feast" description="The Friday Feast: a free holiday celebration of food, fun and community from We Stand 4 Something.">
  <PageIntro title="The Friday Feast is back!">
    <p><strong><time datetime="2025-11-21">Friday, November 21, 2025</time></strong></p>
  </PageIntro>

  <section class="section" aria-label="About the Friday Feast">
    <div class="container prose">
      <p>We Stand 4 Something is proud to bring back The Friday Feast: a night of food, fun, and community!</p>
      <p>
        This free celebration is more than just a meal. It’s a space where everyone belongs. People with and without
        disabilities come together to share joy, connection, and holiday cheer. For many, this is the only holiday celebration
        where they feel truly welcomed. It’s a night where strangers become friends, families come together, and everyone has
        a seat at the table.
      </p>
      <h2>Help make the Feast happen</h2>
      <p>If you would like to support the Friday Feast, you can donate online. Thank you for your donation!</p>
      <div class="btn-row">
        <a class="btn btn-accent" href={DONATE.url}>Donate to the Friday Feast</a>
        <a class="btn btn-outline" href={url('photo-gallery/')}>See photos from 2018</a>
      </div>
    </div>
  </section>
</Base>
