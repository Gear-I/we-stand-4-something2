---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import type { IconName } from '../data/icons';
import { LOGO } from '../data/site';
import { TEAM } from '../data/team';
import { url, wix } from '../lib/site';

// Short descriptions are drawn from the Services, About and Friday Feast pages.
const help: { title: string; href: string; icon: IconName; text: string }[] = [
  { title: 'Advocacy', href: 'services/', icon: 'megaphone', text: 'Learning to speak up for yourself is the first step to true independence.' },
  { title: 'Coaching', href: 'services/', icon: 'chat', text: 'Self-advocacy skills and public speaking coaching, so people can find their own voice.' },
  { title: 'Social groups', href: 'services/', icon: 'social', text: 'Groups for brain injury survivors, and for parents and caregivers.' },
  { title: 'Life skills', href: 'services/', icon: 'network', text: 'Help with housing, applications, employment and the skills to live independently.' },
  { title: 'Resources', href: 'resources/', icon: 'down', text: 'Delaware agencies and programs that support people with disabilities.' },
  { title: 'Friday Feast', href: 'friday-feast/', icon: 'chevrons', text: 'A free holiday celebration where everyone has a seat at the table.' },
];
const founder = TEAM[0];
---
<Base>
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero-grid">
      <div>
        <h1 id="hero-title">Enhancing independence for people with disabilities</h1>
        <p class="hero-lead">
          We Stand 4 Something provides the bridge between traditional services and the full, engaged lives people want.
          Our services are free for our clients.
        </p>
        <div class="btn-row">
          <a class="btn btn-primary" href={url('services/')}>Explore our services</a>
          <a class="btn btn-outline" href={url('blank/')}>Donate or volunteer</a>
        </div>
      </div>
      <div class="hero-art">
        <svg class="stroke" viewBox="0 0 400 300" preserveAspectRatio="none" aria-hidden="true">
          <path d="M18 92C60 40 160 22 248 30c70 6 128 26 140 70 14 52-10 118-70 152-70 40-190 44-256 4C8 226-6 160 18 92z" />
        </svg>
        <img src={wix(`${LOGO}/v1/fill/w_840,h_840,al_c,q_90,usm_0.66_1.00_0.01/logo.png`)} alt="We Stand 4 Something logo: a raised hand holding the globe" width="420" height="420" />
      </div>
    </div>
  </section>

  <section class="section section--mist" aria-labelledby="help-title">
    <div class="container">
      <h2 id="help-title">How we help</h2>
      <ul class="help-list">
        {help.map((h) => (
          <li class="help-item">
            <span class="help-icon"><Icon name={h.icon} /></span>
            <div>
              <h3><a href={url(h.href)}>{h.title}</a></h3>
              <p>{h.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="founder-title">
    <div class="container feature">
      <img src={founder.photo} alt="Emmanuel Jenkins smiling" width="327" height="317" loading="lazy" />
      <div class="prose">
        <h2 id="founder-title">Meet our founder</h2>
        <p>
          Emmanuel Jenkins is a dedicated advocate and the founder of We Stand 4 Something. With over 20 years of
          experience in public speaking and community leadership, he works tirelessly to support individuals with
          disabilities and their families.
        </p>
        <a class="btn btn-primary" href={url(founder.href)}>Read Emmanuel’s story</a>
      </div>
    </div>
  </section>
</Base>
