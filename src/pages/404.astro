---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import { url } from '../lib/site';
---
<Base title="Page not found">
  <PageIntro title="We can’t find that page">
    <p>The page may have moved, or the address may have a typo.</p>
  </PageIntro>
  <div class="section">
    <div class="container prose">
      <div class="btn-row">
        <a class="btn btn-primary" href={url()}>Go to the home page</a>
        <a class="btn btn-outline" href={url('services/')}>See our services</a>
      </div>
    </div>
  </div>
</Base>
