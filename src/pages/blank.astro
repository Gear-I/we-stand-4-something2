---
// "Support us". The URL /blank/ is kept from the original Wix site.
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import { CONTACT, DONATE } from '../data/site';

const volunteer = `mailto:${CONTACT.volunteerEmail}?subject=${encodeURIComponent('I would like to volunteer')}`;
---
<Base title="Support us" current="blank/" description="Donate to or volunteer with We Stand 4 Something.">
  <PageIntro title="Support us">
    <p>We rely on the support of our community. Every gift of money or time helps.</p>
  </PageIntro>

  <section class="section" aria-labelledby="donate">
    <div class="container prose">
      <h2 id="donate">Donate</h2>
      <p>
        Show your love today and send us a donation, no matter what size! Your funds go directly to support our programs and
        bring someone with a disability one step closer to realizing the dream of living a full, active and rewarding life.
      </p>
      <div class="btn-row">
        <a class="btn btn-accent" href={DONATE.url}>{DONATE.label}</a>
        <a class="btn btn-outline" href={`mailto:${CONTACT.email}?subject=${encodeURIComponent('Donation question')}`}>Email us about other ways to give</a>
      </div>
    </div>
  </section>

  <section class="section section--mist" aria-labelledby="volunteer">
    <div class="container prose">
      <h2 id="volunteer">Volunteer</h2>
      <p>
        Everyone has something to offer! We currently need help in the office (filing, phones and more), media help (website,
        Facebook, X/Twitter), and probably other things we don't even know we need yet.
      </p>
      <a class="btn btn-primary" href={volunteer}>Email us about volunteering</a>
    </div>
  </section>
</Base>
