---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import { url } from '../lib/site';
---
<Base title="Shop" current="shop/">
  <PageIntro title="Shop">
    <p>We don’t have any products to show here right now.</p>
  </PageIntro>
  <div class="section">
    <div class="container prose">
      <p>You can still support our work by donating or volunteering.</p>
      <a class="btn btn-primary" href={url('blank/')}>Ways to support us</a>
    </div>
  </div>
</Base>
