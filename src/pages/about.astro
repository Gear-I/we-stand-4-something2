---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import { TEAM } from '../data/team';
import { url } from '../lib/site';

// The original "Values and Beliefs" text, split into each belief and what we do about it.
const values: { belief: string; action: string }[] = [
  {
    belief: 'We believe everyone is entitled to an individualized education that plays to their strengths.',
    action: 'We provide education and advocacy services for families and assist them through the IEP process.',
  },
  {
    belief: 'We value the voices of people with disabilities and know that each person has a story to tell.',
    action: 'We provide teaching self-advocacy skills and coaching in public speaking so people can find their own voice and share it with others.',
  },
  {
    belief: 'We believe all people should have a safe environment in which to live that is suited to their unique needs and to live where they desire.',
    action: 'We provide assistance with locating housing, supporting people throughout the process, from finding a great location to move-in day and beyond.',
  },
  {
    belief: 'We believe all people should be able to access public services.',
    action: 'We provide assistance to navigate application and eligibility requirements for assistance programs.',
  },
  {
    belief: 'We believe all people need to get out and have fun!',
    action: 'We provide opportunities for people to get together in their communities, connect with others, and have a good time!',
  },
  {
    belief: 'We value the safeguards provided to us by the ADA. We believe all people should be educated about the ADA.',
    action: 'Our approved ADA trainers provide information to individuals and organizations using the Mid-Atlantic ADA Center and Cornell University’s training materials.',
  },
  {
    belief: 'We believe every person who wants to work must have the opportunity to work.',
    action: 'We help people find employment while offering training to develop needed skills, including resume writing, dressing for success, communicating at work, etc. that will help them to be great employees.',
  },
  {
    belief: 'We believe everyone needs a safe space and the opportunity to talk to others experiencing the same life circumstances.',
    action: 'We offer services to help families connect to one another so they can share experiences and learn from each other.',
  },
];
---
<Base title="About us" current="about/" description="The mission, vision, values and board members of We Stand 4 Something.">
  <PageIntro title="About us" />

  <section class="section" aria-labelledby="mission">
    <div class="container prose">
      <h2 id="mission">Our mission</h2>
      <p>
        We Stand 4 Something, Inc. provides the bridge between traditional services and the full, engaged lives people want.
        We have first-hand experiences understanding people with disabilities because we are people with disabilities and their families.
      </p>
      <p>
        We pledge to primarily employ people with disabilities to deliver our services. We empower people and their families
        to use advocacy to tailor their environments to supplement their strengths. We support people to live lives of quality,
        fully included within their communities.
      </p>
      <h2 id="vision">Our vision</h2>
      <p>
        To enhance the lives of people with disabilities by teaching them skills they can use to speak for themselves for their whole lives.
      </p>
    </div>
  </section>

  <section class="section section--mist" aria-labelledby="values-title">
    <div class="container">
      <h2 id="values-title">Our values and beliefs</h2>
      <ul class="values prose">
        {values.map((v) => (
          <li>
            <strong>{v.belief}</strong>
            {v.action}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="board-title">
    <div class="container">
      <h2 id="board-title">Our board members</h2>
      <p>Select a name to read their biography.</p>
      <ul class="people">
        {TEAM.map((m) => (
          <li class="person">
            <a href={url(m.href)}>
              <img src={m.thumb} alt="" width="240" height="240" loading="lazy" />
              <span class="person-name">{m.name}</span>
              <span class="person-role">{m.role}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
