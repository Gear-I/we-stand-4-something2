---
// Blog index. The URL /blog-1/ is kept from the original Wix site.
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import PostMeta from '../components/PostMeta.astro';
import { POSTS } from '../data/site';
import { url, wix } from '../lib/site';

const posts = [...POSTS].sort((a, b) => b.date.localeCompare(a.date));
const cover = (p: (typeof POSTS)[number]) =>
  p.youtube ? `https://img.youtube.com/vi/${p.youtube}/hqdefault.jpg` : wix(`${p.image}/v1/fill/w_720,h_540,fp_0.50_0.50,lg_1,q_85/post.jpg`);
---
<Base title="Blog" current="blog-1/" description="News and stories from We Stand 4 Something.">
  <PageIntro title="Blog" />
  <div class="section">
    <div class="container">
      <ul class="post-list">
        {posts.map((p) => (
          <li>
            <article class="post-card panel">
              <img src={cover(p)} alt="" width="288" height="216" loading="lazy" />
              <div>
                <h2><a href={url(`post/${p.slug}/`)}>{p.title}</a></h2>
                <PostMeta post={p} />
                {p.excerpt && <p>{p.excerpt}</p>}
              </div>
            </article>
          </li>
        ))}
      </ul>
    </div>
  </div>
</Base>
