---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import EventItem from '../components/EventItem.astro';
import ContactForm, { type Field } from '../components/ContactForm.astro';
import { EVENTS } from '../data/events';
import { CONTACT } from '../data/site';

// Split at build time: the site rebuilds on every push to main.
const today = new Date().toISOString().slice(0, 10);
const upcoming = EVENTS.filter((e) => e.date >= today).sort((a, b) => a.date.localeCompare(b.date));
const past = EVENTS.filter((e) => e.date < today).sort((a, b) => b.date.localeCompare(a.date));

const fields: Field[] = [
  { name: 'name', label: 'Your name', type: 'text', required: true, autocomplete: 'name', pairWithNext: true },
  { name: 'email', label: 'Email address', type: 'email', required: true, autocomplete: 'email' },
  { name: 'event', label: 'Which event are you registering for?', type: 'text', required: true },
  { name: 'needs', label: 'Accessibility needs or questions', type: 'textarea', hint: 'For example: wheelchair seating, an interpreter, or dietary needs.' },
];
---
<Base title="Events" current="events/" description="Upcoming events from We Stand 4 Something, and how to register.">
  <PageIntro title="Events" />

  <section class="section" aria-labelledby="upcoming">
    <div class="container prose">
      <h2 id="upcoming">Upcoming events</h2>
      {upcoming.length ? (
        <ul class="event-list">{upcoming.map((e) => <EventItem event={e} />)}</ul>
      ) : (
        <p>
          There are no upcoming events listed right now. Check back soon, or email
          <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a> to hear about the next one.
        </p>
      )}
    </div>
  </section>

  <section class="section section--mist" aria-labelledby="register">
    <div class="container">
      <div class="panel" style="max-width:44rem">
        <h2 id="register">Register for an event</h2>
        <ContactForm id="register" subject="Event registration" fields={fields} submitLabel="Send registration" />
      </div>
    </div>
  </section>

  {past.length > 0 && (
    <section class="section" aria-labelledby="past">
      <div class="container prose">
        <h2 id="past">Past events</h2>
        <ul class="event-list">{past.map((e) => <EventItem event={e} />)}</ul>
      </div>
    </section>
  )}
</Base>
