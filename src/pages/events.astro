---
import Base from '../layouts/Base.astro';
import Box from '../components/Box.astro';
import Calendar from '../components/Calendar.astro';
import ContactForm, { type Field } from '../components/ContactForm.astro';
import { contentHeight, stackShadow, FONTS } from '../lib/layout';

const fields: Field[] = [
  { x: 291, y: 1158, w: 680, h: 60, name: 'name', placeholder: 'Name', type: 'text', required: true },
  { x: 291, y: 1230, w: 680, h: 60, name: 'email', placeholder: 'Email', type: 'email', required: true },
  { x: 291, y: 1302, w: 680, h: 129, name: 'message', placeholder: 'Tell us which event you are registering for', type: 'textarea', required: true },
];
---
<Base title="Events | ws4s" height={contentHeight(1780)} bg="#CADDE6" current="events/">
  <Calendar x={238} y={380} w={797} />

  <Box x={277} y={1081} w={710} h={423} style="background:#fff" />
  <ContactForm
    x={277} y={1081} w={710} h={423}
    subject="Event registration"
    fields={fields}
    fieldStyle="border:0.67px solid #67D6D6;box-shadow:0 2px 0 0 #67D6D6;background:#fff"
    button={{
      x: 291, y: 1428, w: 340, h: 53, label: 'Submit',
      style: `background:#6DCFB6;color:#F0FAFF;border-radius:5px;box-shadow:${stackShadow('#37685B')};font:400 25px ${FONTS.os}`,
    }}
  >
    <h2 style={`position:absolute;left:14px;top:27px;margin:0;font:italic 700 25px ${FONTS.bree};color:#00E689`}>Register for events</h2>
  </ContactForm>
</Base>
