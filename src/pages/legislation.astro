---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import { wix } from '../lib/site';

const photo = wix('0bae78_10a419dc9cd84e21b8a7c458a2f30f24~mv2.jpg/v1/fill/w_790,h_448,al_c,q_80,usm_0.66_1.00_0.01/bill-signing.jpg');
const video = 'https://livestream.com/StateofDelaware/aug6/videos/194701430';
const news = 'https://news.delaware.gov/2019/08/07/icymi-governor-carney-signs-legislation-protecting-health-care-for-delawareans/';
---
<Base title="Local legislation" current="legislation/" description="Delaware legislative news that affects people with disabilities.">
  <PageIntro title="Local legislation">
    <p>Delaware laws and policy news that affect people with disabilities.</p>
  </PageIntro>

  <div class="section">
    <article class="container feature" aria-labelledby="sb35">
      <img src={photo} alt="Governor John Carney at the bill signing" width="395" height="224" loading="lazy" />
      <div class="prose">
        <h2 id="sb35">Protecting health care for people with pre-existing conditions</h2>
        <p class="post-meta"><time datetime="2019-08-07">August 7, 2019</time></p>
        <p>
          On August 7th, 2019, Governor John Carney signed Senate Bill 35 and Senate Substitute 1 for Senate Bill 92 into
          effect. Both bills were passed to ensure that individuals with pre-existing conditions are protected and do not have
          limited access to health care.
        </p>
        <div class="btn-row">
          <a class="btn btn-primary" href={video}>Watch the bill signing video</a>
          <a class="btn btn-outline" href={news}>Read the State of Delaware news release</a>
        </div>
      </div>
    </article>
  </div>
</Base>
