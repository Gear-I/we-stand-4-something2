---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import Icon from '../components/Icon.astro';
import SignupDialog from '../components/SignupDialog.astro';
---
<Base title="Our services" current="services/" description="Advocacy, resource connection and social interaction groups from We Stand 4 Something. All services are free for our clients.">
  <PageIntro title="Our services">
    <p class="callout">All our services are free of charge for our clients.</p>
  </PageIntro>

  <div class="section">
    <div class="container">
      <section class="service" aria-labelledby="advocacy">
        <span class="help-icon"><Icon name="megaphone" /></span>
        <div class="prose">
          <h2 id="advocacy">Advocacy</h2>
          <p>
            “Teach a man to fish and he eats for a lifetime...” We are firm believers in self advocacy. Learning to speak up for
            yourself is the first step to true independence.
          </p>
          <p>We also work with our state legislators and community partners to increase service offerings throughout Delaware.</p>
        </div>
      </section>

      <section class="service" aria-labelledby="resource-connection">
        <span class="help-icon"><Icon name="network" /></span>
        <div class="prose">
          <h2 id="resource-connection">Resource connection</h2>
          <p>
            Are you looking for access to financial, educational, life skills, and/or social development resources? At We Stand
            4 Something, we open the door to possibilities that allow those we serve to be more independent and live the life
            they deserve.
          </p>
          <p>If you or someone you know is looking for access to services, we are here to assist you.</p>
        </div>
      </section>

      <section class="service" aria-labelledby="social-groups">
        <span class="help-icon"><Icon name="social" /></span>
        <div class="prose">
          <h2 id="social-groups">Social interaction groups</h2>

          <div class="group">
            <h3>Brain Injury Survivor Group</h3>
            <p>Our brain injury social interaction group meets online on the 1st and 3rd Tuesday of each month.</p>
            <button class="btn btn-primary" type="button" data-open-dialog="brain-injury">Join the Brain Injury Survivor Group</button>
          </div>

          <div class="group">
            <h3>Parent and Caregiver Group</h3>
            <p>A social interaction group for parents and caregivers.</p>
            <button class="btn btn-primary" type="button" data-open-dialog="caregiver">Join the Parent and Caregiver Group</button>
          </div>
        </div>
      </section>
    </div>
  </div>

  <SignupDialog id="brain-injury" title="Join the Brain Injury Survivor Group" intro="Tell us how to reach you and we will send you the meeting details." />
  <SignupDialog id="caregiver" title="Join the Parent and Caregiver Group" intro="Tell us how to reach you and we will send you the group details." />
</Base>
