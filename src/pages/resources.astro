---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import { RESOURCES } from '../data/resources';
import { url, wix } from '../lib/site';
---
<Base title="Resources" current="resources/" description="Delaware agencies, programs and guides for people with disabilities and their families.">
  <PageIntro title="Resources for Delawareans">
    <p>
      We will continually update the resources on this page to help people with access and functional needs get the
      services they are entitled to.
    </p>
  </PageIntro>

  <div class="section">
    <div class="container">
      <ul class="resource-list">
        {RESOURCES.map((r) => (
          <li class="panel resource">
            <div class="logo"><img src={wix(r.logo)} alt="" width="200" height="140" loading="lazy" /></div>
            <h2>{r.name}</h2>
            <a class="btn btn-primary" href={r.url}>
              {r.pdf ? 'Open the guide' : 'Visit the website'}
              <span class="visually-hidden"> for {r.name}</span>{r.pdf && ' (PDF)'}
            </a>
          </li>
        ))}
      </ul>

      <div class="panel prose" style="margin-top:2.5rem">
        <h2>Know a resource we should add?</h2>
        <p>If there is a resource you feel is important and it is not listed here, please let us know.</p>
        <a class="btn btn-outline" href={url('feedback/')}>Suggest a resource</a>
      </div>
    </div>
  </div>
</Base>
