---
/**
 * A form with visible labels. GitHub Pages can't receive form posts, so sending opens the
 * visitor's email app with the message filled in (see scripts/mailto-forms.ts).
 */
import { CONTACT } from '../data/site';

export interface Field {
  name: string;
  label: string;
  type: 'text' | 'email' | 'tel' | 'textarea';
  required?: boolean;
  autocomplete?: string;
  hint?: string;
  /** Put this field side by side with the next one on wide screens. */
  pairWithNext?: boolean;
}

interface Props {
  /** Unique prefix for field ids. */
  id: string;
  subject: string;
  fields: Field[];
  submitLabel: string;
}

const { id, subject, fields, submitLabel } = Astro.props;

// Group fields into rows (pairs where requested)
const rows: Field[][] = [];
for (let i = 0; i < fields.length; i++) {
  if (fields[i].pairWithNext && fields[i + 1]) { rows.push([fields[i], fields[i + 1]]); i++; }
  else rows.push([fields[i]]);
}
const hasRequired = fields.some((f) => f.required);
---
<form class="form" data-subject={subject} action={`mailto:${CONTACT.email}`} method="post" enctype="text/plain">
  {hasRequired && <p class="form-note">Fields marked <span class="req" aria-hidden="true">*</span> (required) must be filled in.</p>}
  {rows.map((row) => (
    <div class={row.length > 1 ? 'form-row' : undefined}>
      {row.map((f) => {
        const fid = `${id}-${f.name}`;
        const hintId = f.hint ? `${fid}-hint` : undefined;
        return (
          <div class="field">
            <label for={fid}>
              {f.label}{f.required && <span class="req" aria-hidden="true"> *</span>}{f.required && <span class="visually-hidden"> (required)</span>}
            </label>
            {f.hint && <span class="hint" id={hintId}>{f.hint}</span>}
            {f.type === 'textarea' ? (
              <textarea id={fid} name={f.name} required={f.required} aria-describedby={hintId} rows="6"></textarea>
            ) : (
              <input id={fid} type={f.type} name={f.name} required={f.required} autocomplete={f.autocomplete} aria-describedby={hintId} />
            )}
          </div>
        );
      })}
    </div>
  ))}
  <p class="form-note">
    Choosing “{submitLabel}” opens your email app with your message ready to send to {CONTACT.email}.
    You can also call us at <a href={`tel:${CONTACT.phone}`}>{CONTACT.phoneDisplay}</a>.
  </p>
  <div><button class="btn btn-primary" type="submit">{submitLabel}</button></div>
</form>

<script>
  import { initMailtoForms } from '../scripts/mailto-forms';
  initMailtoForms();
</script>
