---
/** A positioned block of text. Content goes in the slot (may contain links). */
import Abs from './Abs.astro';
import type { HTMLTag } from 'astro/types';
import { FONTS, type FontKey } from '../lib/layout';

interface Props {
  x: number;
  y: number;
  w?: number;
  h?: number;
  font?: FontKey;
  size?: number;
  weight?: number;
  color?: string;
  align?: 'left' | 'center' | 'right' | 'justify';
  lh?: string;
  ls?: string;
  italic?: boolean;
  as?: HTMLTag;
  href?: string;
  ext?: boolean;
  class?: string;
  style?: string;
}

const {
  font = 'enr', size = 14, weight = 400, color = '#292F33', align, lh = 'normal', ls,
  italic = false, as = 'div', style = '', ...rest
} = Astro.props;

let css = `font:${italic ? 'italic ' : ''}${weight} ${size}px/${lh} ${FONTS[font]};color:${color};`;
if (align) css += `text-align:${align};`;
if (ls) css += `letter-spacing:${ls};`;
if (/^h[1-6]$|^p$/.test(as)) css += 'margin:0;';
---
<Abs as={as} style={css + style} {...rest}><slot /></Abs>
