---
/** Home page button with an icon, a label and the stepped shadow. Coordinates are page coordinates. */
import Icon from './Icon.astro';
import type { IconName } from '../data/icons';
import { pos, stackShadow } from '../lib/layout';

interface Props {
  x: number;
  y: number;
  w: number;
  h: number;
  label: string;
  href: string;
  bg: string;
  shadow: string;
  icon: IconName;
  /** Icon top-left and size, in page coordinates. */
  iconAt: [number, number, number];
  /** Label top-left, in page coordinates. */
  labelAt: [number, number];
  size?: number;
  lh?: string;
}

const { x, y, w, h, label, href, bg, shadow, icon, iconAt, labelAt, size = 25, lh = '27.5px' } = Astro.props;
const [ix, iy, isz] = iconAt;
const [lx, ly] = labelAt;
---
<a class="a stack-btn" href={href} style={pos(x, y, w, h) + `background:${bg};box-shadow:${stackShadow(shadow)};`}>
  <Icon name={icon} style={`left:${ix - x}px;top:${iy - y}px;width:${isz}px;height:${isz}px`} />
  <span style={`left:${lx - x}px;top:${ly - y}px;font-size:${size}px;line-height:${lh}`}>{label}</span>
</a>
