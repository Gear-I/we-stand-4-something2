---
/** A decorative rectangle (rule, panel, divider). Hidden on phones unless class is overridden. */
import { pos } from '../lib/layout';

interface Props {
  x: number;
  y: number;
  w: number;
  h: number;
  style: string;
  class?: string;
}

const { x, y, w, h, style, class: cls = 'deco' } = Astro.props;
---
<div class:list={['a', cls]} style={pos(x, y, w, h) + style} aria-hidden="true"></div>
